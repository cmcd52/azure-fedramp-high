{
  "name": "audit-entra-domain-services-diagnostic-settings-v1",
  "properties": {
    "displayName": "[FedRAMP High] Microsoft Entra Domain Services: Diagnostic Settings Enabled",
    "description": "Audits Microsoft Entra Domain Services resources to ensure diagnostic settings are configured to forward logs to a Log Analytics workspace. NIST 800-53 AU-12 requires audit generation to support continuous monitoring and incident response.",
    "mode": "All",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Microsoft Entra Domain Services",
      "nistControls": [
        "AU-12",
        "AU-2"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ],
      "severity": "Medium",
      "fipsApplicable": false,
      "stigFindingId": "No STIG available",
      "environment": "all"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists: Report resources without diagnostic settings. Disabled: Do not evaluate."
        }
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.AAD/domainServices"
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/diagnosticSettings",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                "exists": true
              },
              {
                "count": {
                  "field": "Microsoft.Insights/diagnosticSettings/logs[*]",
                  "where": {
                    "field": "Microsoft.Insights/diagnosticSettings/logs[*].enabled",
                    "equals": true
                  }
                },
                "greaterOrEquals": 1
              }
            ]
          }
        }
      }
    }
  }
}
