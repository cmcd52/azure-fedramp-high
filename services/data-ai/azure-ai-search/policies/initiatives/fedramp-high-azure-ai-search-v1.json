{
  "name": "fedramp-high-azure-ai-search-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure AI Search Controls",
    "description": "Policy initiative for Azure AI Search FedRAMP High compliance. Bundles policies for public access prevention, managed identity authentication, and TLS 1.2 minimum enforcement. Azure AI Search indexing federal data must enforce network isolation, identity-based access, and encrypted communications.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure AI Search",
      "nistControls": ["SC-7", "SC-8", "IA-2"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"]
    },
    "parameters": {
      "publicAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Public Access Effect",
          "description": "Effect for the AI Search public access policy."
        }
      },
      "managedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Deny", "Disabled"],
        "metadata": {
          "displayName": "Managed Identity Effect",
          "description": "Effect for the AI Search managed identity policy."
        }
      },
      "minimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Minimum TLS Effect",
          "description": "Effect for the AI Search minimum TLS version policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "denyAISearchPublicAccess",
        "policyDefinitionName": "deny-aisearch-public-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('publicAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAISearchManagedIdentity",
        "policyDefinitionName": "audit-aisearch-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('managedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyAISearchMinimumTls",
        "policyDefinitionName": "deny-aisearch-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('minimumTlsEffect')]"
          }
        }
      }
    ]
  }
}
