{
  "name": "fedramp-high-hdinsight-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure HDInsight Controls",
    "description": "Policy initiative for Azure HDInsight FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure HDInsight",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-8",
        "SC-13",
        "IA-2",
        "AC-3",
        "SC-12",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditHdinsightDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure HDInsight: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure HDInsight: Diagnostic Settings Enabled policy."
        }
      },
      "denyHdinsightMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure HDInsight: Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] Azure HDInsight: Minimum TLS 1.2 policy."
        }
      },
      "auditHdinsightManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure HDInsight: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure HDInsight: Managed Identity Required policy."
        }
      },
      "auditHdinsightCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure HDInsight: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure HDInsight: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditHdinsightDiagnosticSettings",
        "policyDefinitionName": "audit-hdinsight-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditHdinsightDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyHdinsightMinimumTls",
        "policyDefinitionName": "deny-hdinsight-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyHdinsightMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditHdinsightManagedIdentity",
        "policyDefinitionName": "audit-hdinsight-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditHdinsightManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditHdinsightCmk",
        "policyDefinitionName": "audit-hdinsight-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditHdinsightCmkEffect')]"
          }
        }
      }
    ]
  }
}
