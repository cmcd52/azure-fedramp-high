{
  "name": "fedramp-high-sql-database-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure SQL Database Controls",
    "description": "Policy initiative for Azure SQL Database FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure SQL Database",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-8",
        "SC-13",
        "IA-2",
        "AC-3",
        "SC-12",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditSqlDatabaseDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Database: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Database: Diagnostic Settings Enabled policy."
        }
      },
      "denySqlDatabaseMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Database: Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Database: Minimum TLS 1.2 policy."
        }
      },
      "auditSqlDatabaseManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Database: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Database: Managed Identity Required policy."
        }
      },
      "auditSqlDatabaseCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Database: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Database: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditSqlDatabaseDiagnosticSettings",
        "policyDefinitionName": "audit-sql-database-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSqlDatabaseDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denySqlDatabaseMinimumTls",
        "policyDefinitionName": "deny-sql-database-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denySqlDatabaseMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditSqlDatabaseManagedIdentity",
        "policyDefinitionName": "audit-sql-database-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSqlDatabaseManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditSqlDatabaseCmk",
        "policyDefinitionName": "audit-sql-database-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSqlDatabaseCmkEffect')]"
          }
        }
      }
    ]
  }
}
