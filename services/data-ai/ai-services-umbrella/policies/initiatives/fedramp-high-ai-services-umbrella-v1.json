{
  "name": "fedramp-high-ai-services-umbrella-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure AI Services (Umbrella) Controls",
    "description": "Policy initiative for Azure AI Services (Umbrella) FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure AI Services (Umbrella)",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "IA-2",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditAiServicesUmbrellaDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure AI Services (Umbrella): Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure AI Services (Umbrella): Diagnostic Settings Enabled policy."
        }
      },
      "denyAiServicesUmbrellaPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure AI Services (Umbrella): Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure AI Services (Umbrella): Public Network Access Disabled policy."
        }
      },
      "auditAiServicesUmbrellaManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure AI Services (Umbrella): Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure AI Services (Umbrella): Managed Identity Required policy."
        }
      },
      "auditAiServicesUmbrellaCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure AI Services (Umbrella): Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure AI Services (Umbrella): Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditAiServicesUmbrellaDiagnosticSettings",
        "policyDefinitionName": "audit-ai-services-umbrella-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAiServicesUmbrellaDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyAiServicesUmbrellaPublicNetworkAccess",
        "policyDefinitionName": "deny-ai-services-umbrella-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyAiServicesUmbrellaPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAiServicesUmbrellaManagedIdentity",
        "policyDefinitionName": "audit-ai-services-umbrella-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAiServicesUmbrellaManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAiServicesUmbrellaCmk",
        "policyDefinitionName": "audit-ai-services-umbrella-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAiServicesUmbrellaCmkEffect')]"
          }
        }
      }
    ]
  }
}
