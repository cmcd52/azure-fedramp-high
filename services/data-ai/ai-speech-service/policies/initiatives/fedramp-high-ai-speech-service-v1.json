{
  "name": "fedramp-high-ai-speech-service-v1",
  "properties": {
    "displayName": "[FedRAMP High] AI Speech Service Controls",
    "description": "Policy initiative for Azure AI Speech Service FedRAMP High compliance. Bundles policies for public access prevention and managed identity authentication. Speech services processing federal audio data must enforce network isolation and identity-based access to protect PII in speech content.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "AI Speech Service",
      "nistControls": ["SC-7", "IA-2"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"]
    },
    "parameters": {
      "publicAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Public Access Effect",
          "description": "Effect for the AI Speech Service public access policy."
        }
      },
      "managedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Deny", "Disabled"],
        "metadata": {
          "displayName": "Managed Identity Effect",
          "description": "Effect for the AI Speech Service managed identity policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "denySpeechPublicAccess",
        "policyDefinitionName": "deny-speech-public-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('publicAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditSpeechManagedIdentity",
        "policyDefinitionName": "audit-speech-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('managedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
