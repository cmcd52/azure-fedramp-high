{
  "name": "fedramp-high-sql-server-logical-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure SQL Server (Logical) Controls",
    "description": "Policy initiative for Azure SQL Server (Logical) FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure SQL Server (Logical)",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "SC-8",
        "SC-13",
        "IA-2"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditSqlServerLogicalDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Server (Logical): Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Server (Logical): Diagnostic Settings Enabled policy."
        }
      },
      "denySqlServerLogicalPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Server (Logical): Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Server (Logical): Public Network Access Disabled policy."
        }
      },
      "denySqlServerLogicalMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Server (Logical): Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Server (Logical): Minimum TLS 1.2 policy."
        }
      },
      "auditSqlServerLogicalManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SQL Server (Logical): Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure SQL Server (Logical): Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditSqlServerLogicalDiagnosticSettings",
        "policyDefinitionName": "audit-sql-server-logical-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSqlServerLogicalDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denySqlServerLogicalPublicNetworkAccess",
        "policyDefinitionName": "deny-sql-server-logical-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denySqlServerLogicalPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denySqlServerLogicalMinimumTls",
        "policyDefinitionName": "deny-sql-server-logical-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denySqlServerLogicalMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditSqlServerLogicalManagedIdentity",
        "policyDefinitionName": "audit-sql-server-logical-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSqlServerLogicalManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
