{
  "name": "audit-machine-learning-cmk-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Machine Learning: Customer-Managed Key Encryption",
    "description": "Audits Azure Machine Learning resources to verify customer-managed key (CMK) encryption-at-rest is configured. NIST 800-53 SC-12 (Key Establishment), SC-13 (Cryptographic Protection), and SC-28 (Protection of Information at Rest) recommend CMK with FIPS 140-2 validated modules for federal workloads.",
    "mode": "Indexed",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Machine Learning",
      "nistControls": [
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2",
        "FIPS 140-2"
      ],
      "severity": "Medium",
      "fipsApplicable": true,
      "stigFindingId": "No STIG available",
      "environment": "all"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Audit: Report. Deny: Block. Disabled: Do not evaluate."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.MachineLearningServices/workspaces"
          },
          {
            "field": "Microsoft.MachineLearningServices/workspaces/encryption.keyVaultProperties.keyIdentifier",
            "exists": false
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
