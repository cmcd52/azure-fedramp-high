{
  "name": "audit-aifoundry-managed-identity-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure AI Foundry: Managed Identity Required",
    "description": "Audits Azure AI Foundry Hub and Project resources that do not have a managed identity configured. FedRAMP High requires identification and authentication (IA-2). Managed Identity eliminates credential management and enables Entra ID authentication with RBAC, conditional access policies, and centralized audit logging.",
    "mode": "Indexed",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure AI Foundry",
      "nistControls": ["IA-2"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"],
      "severity": "High",
      "fipsApplicable": false,
      "stigFindingId": "No STIG available",
      "environment": "all"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Deny", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "Audit: Report AI Foundry resources without managed identity. Deny: Block deployment. Disabled: Do not evaluate."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.MachineLearningServices/workspaces"
          },
          {
            "anyOf": [
              {
                "field": "Microsoft.MachineLearningServices/workspaces/kind",
                "equals": "Hub"
              },
              {
                "field": "Microsoft.MachineLearningServices/workspaces/kind",
                "equals": "Project"
              }
            ]
          },
          {
            "field": "identity.type",
            "notContains": "SystemAssigned"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
