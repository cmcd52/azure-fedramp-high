{
  "name": "fedramp-high-cosmos-db-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Cosmos DB Controls",
    "description": "Policy initiative for Azure Cosmos DB FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Cosmos DB",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "IA-2",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditCosmosDbDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Cosmos DB: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Cosmos DB: Diagnostic Settings Enabled policy."
        }
      },
      "denyCosmosDbPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Cosmos DB: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Cosmos DB: Public Network Access Disabled policy."
        }
      },
      "auditCosmosDbManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Cosmos DB: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Cosmos DB: Managed Identity Required policy."
        }
      },
      "auditCosmosDbCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Cosmos DB: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure Cosmos DB: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditCosmosDbDiagnosticSettings",
        "policyDefinitionName": "audit-cosmos-db-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditCosmosDbDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyCosmosDbPublicNetworkAccess",
        "policyDefinitionName": "deny-cosmos-db-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyCosmosDbPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditCosmosDbManagedIdentity",
        "policyDefinitionName": "audit-cosmos-db-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditCosmosDbManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditCosmosDbCmk",
        "policyDefinitionName": "audit-cosmos-db-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditCosmosDbCmkEffect')]"
          }
        }
      }
    ]
  }
}
