{
  "name": "deny-eventhubs-minimum-tls-v1",
  "properties": {
    "displayName": "[FedRAMP High] Event Hubs: TLS 1.2 Minimum",
    "description": "Denies deployment of Azure Event Hubs namespaces with minimum TLS version below 1.2. FedRAMP High requires transmission confidentiality and integrity (SC-8). TLS 1.0 and 1.1 have known vulnerabilities; all Event Hubs connections must use TLS 1.2 or higher per NIST SP 800-52 Rev 2.",
    "mode": "Indexed",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Event Hubs",
      "nistControls": ["SC-8"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"],
      "severity": "High",
      "fipsApplicable": false,
      "stigFindingId": "No STIG available",
      "environment": "all"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "Deny: Block Event Hubs namespaces with TLS < 1.2. Audit: Report non-compliance only. Disabled: Do not evaluate."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.EventHub/namespaces"
          },
          {
            "field": "Microsoft.EventHub/namespaces/minimumTlsVersion",
            "notEquals": "1.2"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
