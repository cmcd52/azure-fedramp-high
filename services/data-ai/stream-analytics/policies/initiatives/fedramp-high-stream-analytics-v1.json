{
  "name": "fedramp-high-stream-analytics-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Stream Analytics Controls",
    "description": "Policy initiative for Azure Stream Analytics FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Stream Analytics",
      "nistControls": [
        "AU-12",
        "AU-2",
        "IA-2",
        "AC-3",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditStreamAnalyticsDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Stream Analytics: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Stream Analytics: Diagnostic Settings Enabled policy."
        }
      },
      "auditStreamAnalyticsManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Stream Analytics: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Stream Analytics: Managed Identity Required policy."
        }
      },
      "auditStreamAnalyticsCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Stream Analytics: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure Stream Analytics: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditStreamAnalyticsDiagnosticSettings",
        "policyDefinitionName": "audit-stream-analytics-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditStreamAnalyticsDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditStreamAnalyticsManagedIdentity",
        "policyDefinitionName": "audit-stream-analytics-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditStreamAnalyticsManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditStreamAnalyticsCmk",
        "policyDefinitionName": "audit-stream-analytics-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditStreamAnalyticsCmkEffect')]"
          }
        }
      }
    ]
  }
}
