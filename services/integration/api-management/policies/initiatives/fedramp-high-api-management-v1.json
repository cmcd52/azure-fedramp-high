{
  "name": "fedramp-high-api-management-v1",
  "properties": {
    "displayName": "[FedRAMP High] API Management Controls",
    "description": "Policy initiative for API Management FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "API Management",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "SC-8",
        "SC-13",
        "IA-2",
        "SC-12",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditApiManagementDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] API Management: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] API Management: Diagnostic Settings Enabled policy."
        }
      },
      "denyApiManagementPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] API Management: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] API Management: Public Network Access Disabled policy."
        }
      },
      "denyApiManagementMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] API Management: Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] API Management: Minimum TLS 1.2 policy."
        }
      },
      "auditApiManagementManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] API Management: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] API Management: Managed Identity Required policy."
        }
      },
      "auditApiManagementCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] API Management: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] API Management: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditApiManagementDiagnosticSettings",
        "policyDefinitionName": "audit-api-management-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditApiManagementDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyApiManagementPublicNetworkAccess",
        "policyDefinitionName": "deny-api-management-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyApiManagementPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyApiManagementMinimumTls",
        "policyDefinitionName": "deny-api-management-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyApiManagementMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditApiManagementManagedIdentity",
        "policyDefinitionName": "audit-api-management-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditApiManagementManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditApiManagementCmk",
        "policyDefinitionName": "audit-api-management-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditApiManagementCmkEffect')]"
          }
        }
      }
    ]
  }
}
