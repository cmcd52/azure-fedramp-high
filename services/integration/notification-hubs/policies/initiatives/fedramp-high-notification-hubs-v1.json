{
  "name": "fedramp-high-notification-hubs-v1",
  "properties": {
    "displayName": "[FedRAMP High] Notification Hubs Controls",
    "description": "Policy initiative for Notification Hubs FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Notification Hubs",
      "nistControls": [
        "AU-12",
        "AU-2",
        "IA-2",
        "AC-3"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditNotificationHubsDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Notification Hubs: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Notification Hubs: Diagnostic Settings Enabled policy."
        }
      },
      "auditNotificationHubsManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Notification Hubs: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Notification Hubs: Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditNotificationHubsDiagnosticSettings",
        "policyDefinitionName": "audit-notification-hubs-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditNotificationHubsDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditNotificationHubsManagedIdentity",
        "policyDefinitionName": "audit-notification-hubs-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditNotificationHubsManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
