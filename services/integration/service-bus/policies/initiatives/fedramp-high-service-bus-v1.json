{
  "name": "fedramp-high-service-bus-v1",
  "properties": {
    "displayName": "[FedRAMP High] Service Bus Controls",
    "description": "Policy initiative for Service Bus FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Service Bus",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "SC-8",
        "SC-13",
        "IA-2",
        "SC-12",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditServiceBusDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Service Bus: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Service Bus: Diagnostic Settings Enabled policy."
        }
      },
      "denyServiceBusPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Service Bus: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Service Bus: Public Network Access Disabled policy."
        }
      },
      "denyServiceBusMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Service Bus: Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] Service Bus: Minimum TLS 1.2 policy."
        }
      },
      "auditServiceBusManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Service Bus: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Service Bus: Managed Identity Required policy."
        }
      },
      "auditServiceBusCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Service Bus: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Service Bus: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditServiceBusDiagnosticSettings",
        "policyDefinitionName": "audit-service-bus-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditServiceBusDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyServiceBusPublicNetworkAccess",
        "policyDefinitionName": "deny-service-bus-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyServiceBusPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyServiceBusMinimumTls",
        "policyDefinitionName": "deny-service-bus-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyServiceBusMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditServiceBusManagedIdentity",
        "policyDefinitionName": "audit-service-bus-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditServiceBusManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditServiceBusCmk",
        "policyDefinitionName": "audit-service-bus-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditServiceBusCmkEffect')]"
          }
        }
      }
    ]
  }
}
