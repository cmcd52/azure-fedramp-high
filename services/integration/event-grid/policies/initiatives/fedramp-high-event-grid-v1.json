{
  "name": "fedramp-high-event-grid-v1",
  "properties": {
    "displayName": "[FedRAMP High] Event Grid Controls",
    "description": "Policy initiative for Event Grid FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Event Grid",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "SC-8",
        "SC-13",
        "IA-2"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditEventGridDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Event Grid: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Event Grid: Diagnostic Settings Enabled policy."
        }
      },
      "denyEventGridPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Event Grid: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Event Grid: Public Network Access Disabled policy."
        }
      },
      "denyEventGridMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Event Grid: Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] Event Grid: Minimum TLS 1.2 policy."
        }
      },
      "auditEventGridManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Event Grid: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Event Grid: Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditEventGridDiagnosticSettings",
        "policyDefinitionName": "audit-event-grid-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditEventGridDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyEventGridPublicNetworkAccess",
        "policyDefinitionName": "deny-event-grid-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyEventGridPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyEventGridMinimumTls",
        "policyDefinitionName": "deny-event-grid-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyEventGridMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditEventGridManagedIdentity",
        "policyDefinitionName": "audit-event-grid-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditEventGridManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
