{
  "name": "fedramp-high-web-pubsub-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Web PubSub Controls",
    "description": "Policy initiative for Azure Web PubSub FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Web PubSub",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "SC-8",
        "SC-13",
        "IA-2"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditWebPubsubDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Web PubSub: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Web PubSub: Diagnostic Settings Enabled policy."
        }
      },
      "denyWebPubsubPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Web PubSub: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Web PubSub: Public Network Access Disabled policy."
        }
      },
      "denyWebPubsubMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Web PubSub: Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] Azure Web PubSub: Minimum TLS 1.2 policy."
        }
      },
      "auditWebPubsubManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Web PubSub: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Web PubSub: Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditWebPubsubDiagnosticSettings",
        "policyDefinitionName": "audit-web-pubsub-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditWebPubsubDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyWebPubsubPublicNetworkAccess",
        "policyDefinitionName": "deny-web-pubsub-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyWebPubsubPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyWebPubsubMinimumTls",
        "policyDefinitionName": "deny-web-pubsub-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyWebPubsubMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditWebPubsubManagedIdentity",
        "policyDefinitionName": "audit-web-pubsub-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditWebPubsubManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
