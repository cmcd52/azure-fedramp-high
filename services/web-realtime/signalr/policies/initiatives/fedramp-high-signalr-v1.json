{
  "name": "fedramp-high-signalr-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure SignalR Service Controls",
    "description": "Policy initiative for Azure SignalR Service FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure SignalR Service",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "SC-8",
        "SC-13",
        "IA-2"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditSignalrDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SignalR Service: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure SignalR Service: Diagnostic Settings Enabled policy."
        }
      },
      "denySignalrPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SignalR Service: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure SignalR Service: Public Network Access Disabled policy."
        }
      },
      "denySignalrMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SignalR Service: Minimum TLS 1.2 Effect",
          "description": "Effect for the [FedRAMP High] Azure SignalR Service: Minimum TLS 1.2 policy."
        }
      },
      "auditSignalrManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure SignalR Service: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure SignalR Service: Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditSignalrDiagnosticSettings",
        "policyDefinitionName": "audit-signalr-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSignalrDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denySignalrPublicNetworkAccess",
        "policyDefinitionName": "deny-signalr-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denySignalrPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denySignalrMinimumTls",
        "policyDefinitionName": "deny-signalr-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denySignalrMinimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditSignalrManagedIdentity",
        "policyDefinitionName": "audit-signalr-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSignalrManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
