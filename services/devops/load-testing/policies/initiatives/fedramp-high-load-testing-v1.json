{
  "name": "fedramp-high-load-testing-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Load Testing Controls",
    "description": "Policy initiative for Azure Load Testing FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Load Testing",
      "nistControls": [
        "AU-12",
        "AU-2",
        "IA-2",
        "AC-3",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditLoadTestingDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Load Testing: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Load Testing: Diagnostic Settings Enabled policy."
        }
      },
      "auditLoadTestingManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Load Testing: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Load Testing: Managed Identity Required policy."
        }
      },
      "auditLoadTestingCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Load Testing: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure Load Testing: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditLoadTestingDiagnosticSettings",
        "policyDefinitionName": "audit-load-testing-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditLoadTestingDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditLoadTestingManagedIdentity",
        "policyDefinitionName": "audit-load-testing-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditLoadTestingManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditLoadTestingCmk",
        "policyDefinitionName": "audit-load-testing-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditLoadTestingCmkEffect')]"
          }
        }
      }
    ]
  }
}
