{
  "name": "audit-appservice-diagnostic-settings-v1",
  "properties": {
    "displayName": "[FedRAMP High] App Service: Diagnostic Settings Enabled",
    "description": "Audits Azure App Service web apps to ensure diagnostic settings are configured to forward logs to Log Analytics. FedRAMP High requires audit generation (AU-12) to support continuous monitoring and incident response. All App Service log categories must be collected.",
    "mode": "All",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "App Service",
      "nistControls": ["AU-12"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"],
      "severity": "Medium",
      "fipsApplicable": false,
      "stigFindingId": "No STIG available",
      "environment": "all"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": ["AuditIfNotExists", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists: Report App Services without diagnostic settings. Disabled: Do not evaluate."
        }
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.Web/sites"
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/diagnosticSettings",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                "exists": true
              },
              {
                "count": {
                  "field": "Microsoft.Insights/diagnosticSettings/logs[*]",
                  "where": {
                    "field": "Microsoft.Insights/diagnosticSettings/logs[*].enabled",
                    "equals": true
                  }
                },
                "greaterOrEquals": 1
              }
            ]
          }
        }
      }
    }
  }
}
