{
  "name": "fedramp-high-azure-batch-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Batch Controls",
    "description": "Policy initiative for Azure Batch FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Batch",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "IA-2",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditAzureBatchDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Batch: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Batch: Diagnostic Settings Enabled policy."
        }
      },
      "denyAzureBatchPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Batch: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Batch: Public Network Access Disabled policy."
        }
      },
      "auditAzureBatchManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Batch: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Batch: Managed Identity Required policy."
        }
      },
      "auditAzureBatchCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Batch: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure Batch: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditAzureBatchDiagnosticSettings",
        "policyDefinitionName": "audit-azure-batch-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAzureBatchDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyAzureBatchPublicNetworkAccess",
        "policyDefinitionName": "deny-azure-batch-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyAzureBatchPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAzureBatchManagedIdentity",
        "policyDefinitionName": "audit-azure-batch-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAzureBatchManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAzureBatchCmk",
        "policyDefinitionName": "audit-azure-batch-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAzureBatchCmkEffect')]"
          }
        }
      }
    ]
  }
}
