{
  "name": "fedramp-high-site-recovery-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Site Recovery Controls",
    "description": "Policy initiative for Azure Site Recovery FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Site Recovery",
      "nistControls": [
        "AU-12",
        "AU-2",
        "IA-2",
        "AC-3",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditSiteRecoveryDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Site Recovery: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Site Recovery: Diagnostic Settings Enabled policy."
        }
      },
      "auditSiteRecoveryManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Site Recovery: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Site Recovery: Managed Identity Required policy."
        }
      },
      "auditSiteRecoveryCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Site Recovery: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure Site Recovery: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditSiteRecoveryDiagnosticSettings",
        "policyDefinitionName": "audit-site-recovery-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSiteRecoveryDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditSiteRecoveryManagedIdentity",
        "policyDefinitionName": "audit-site-recovery-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSiteRecoveryManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditSiteRecoveryCmk",
        "policyDefinitionName": "audit-site-recovery-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditSiteRecoveryCmkEffect')]"
          }
        }
      }
    ]
  }
}
