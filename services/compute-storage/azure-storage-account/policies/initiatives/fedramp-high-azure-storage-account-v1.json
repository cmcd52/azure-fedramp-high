{
  "name": "fedramp-high-azure-storage-account-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Storage Account Controls",
    "description": "Policy initiative for Azure Storage Account FedRAMP High compliance. Bundles policies for public access prevention, customer-managed key encryption, TLS 1.2 minimum, HTTPS-only transfer, and shared key access disablement. Storage Accounts containing federal data must enforce defense-in-depth: network isolation, encryption with organization-controlled keys, and RBAC-only access.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Storage Account",
      "nistControls": ["SC-7", "SC-8", "SC-13", "SC-28", "AC-3"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"]
    },
    "parameters": {
      "publicAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Public Access Effect",
          "description": "Effect for the Storage Account public blob access policy."
        }
      },
      "cmkEncryptionEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "CMK Encryption Effect",
          "description": "Effect for the Storage Account CMK encryption policy."
        }
      },
      "minimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Minimum TLS Effect",
          "description": "Effect for the Storage Account minimum TLS version policy."
        }
      },
      "httpsOnlyEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "HTTPS Only Effect",
          "description": "Effect for the Storage Account HTTPS transfer only policy."
        }
      },
      "sharedKeyDisabledEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Shared Key Disabled Effect",
          "description": "Effect for the Storage Account shared key access policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "denyStorageAccountPublicAccess",
        "policyDefinitionName": "deny-storageaccount-public-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('publicAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyStorageAccountCmkEncryption",
        "policyDefinitionName": "deny-storageaccount-cmk-encryption-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('cmkEncryptionEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyStorageAccountMinimumTls",
        "policyDefinitionName": "deny-storageaccount-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('minimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyStorageAccountHttpsOnly",
        "policyDefinitionName": "deny-storageaccount-https-only-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('httpsOnlyEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyStorageAccountSharedKeyDisabled",
        "policyDefinitionName": "deny-storageaccount-shared-key-disabled-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('sharedKeyDisabledEffect')]"
          }
        }
      }
    ]
  }
}
