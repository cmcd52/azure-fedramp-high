{
  "name": "fedramp-high-azure-functions-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Functions Controls",
    "description": "Policy initiative for Azure Functions FedRAMP High compliance. Bundles policies for HTTPS enforcement, TLS 1.2 minimum, and managed identity requirement. Function Apps must enforce encryption in transit and strong authentication for all trigger and binding interactions.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Functions",
      "nistControls": ["SC-8", "SC-13", "IA-2"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"]
    },
    "parameters": {
      "httpsOnlyEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "HTTPS Only Effect",
          "description": "Effect for the Functions HTTPS-only policy."
        }
      },
      "minimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Minimum TLS Effect",
          "description": "Effect for the Functions minimum TLS version policy."
        }
      },
      "managedIdentityEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Managed Identity Effect",
          "description": "Effect for the Functions managed identity policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "denyFunctionsHttpsOnly",
        "policyDefinitionName": "deny-functions-https-only-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('httpsOnlyEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyFunctionsMinimumTls",
        "policyDefinitionName": "deny-functions-minimum-tls-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('minimumTlsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyFunctionsManagedIdentity",
        "policyDefinitionName": "deny-functions-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('managedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
