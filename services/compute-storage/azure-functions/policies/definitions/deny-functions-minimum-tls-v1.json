{
  "name": "deny-functions-minimum-tls-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Functions: TLS 1.2 Minimum Required",
    "description": "Denies deployment of Azure Function Apps with a minimum TLS version below 1.2. FedRAMP High requires cryptographic protection (SC-13) and transmission confidentiality (SC-8). TLS 1.0 and 1.1 have known vulnerabilities and are prohibited per NIST SP 800-52 Rev 2.",
    "mode": "Indexed",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Functions",
      "nistControls": ["SC-8", "SC-13"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"],
      "severity": "High",
      "fipsApplicable": true,
      "fips140CertRef": "Platform module",
      "stigFindingId": "No STIG available",
      "environment": "all"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "metadata": {
          "displayName": "Effect",
          "description": "Deny: Block Function Apps with TLS < 1.2. Audit: Report non-compliance only. Disabled: Do not evaluate."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Web/sites/config"
          },
          {
            "field": "name",
            "equals": "web"
          },
          {
            "field": "Microsoft.Web/sites/config/minTlsVersion",
            "notEquals": "1.2"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
