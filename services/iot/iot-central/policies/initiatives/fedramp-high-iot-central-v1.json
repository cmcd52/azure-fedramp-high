{
  "name": "fedramp-high-iot-central-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure IoT Central Controls",
    "description": "Policy initiative for Azure IoT Central FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure IoT Central",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "IA-2"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditIotCentralDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure IoT Central: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure IoT Central: Diagnostic Settings Enabled policy."
        }
      },
      "denyIotCentralPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure IoT Central: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure IoT Central: Public Network Access Disabled policy."
        }
      },
      "auditIotCentralManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure IoT Central: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure IoT Central: Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditIotCentralDiagnosticSettings",
        "policyDefinitionName": "audit-iot-central-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditIotCentralDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyIotCentralPublicNetworkAccess",
        "policyDefinitionName": "deny-iot-central-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyIotCentralPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditIotCentralManagedIdentity",
        "policyDefinitionName": "audit-iot-central-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditIotCentralManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
