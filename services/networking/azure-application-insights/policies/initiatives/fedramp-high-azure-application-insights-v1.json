{
  "name": "fedramp-high-azure-application-insights-v1",
  "properties": {
    "displayName": "[FedRAMP High] Application Insights Controls",
    "description": "Policy initiative for Azure Application Insights FedRAMP High compliance. Bundles policies for workspace-based mode enforcement and local authentication disablement. Application Insights must use workspace-based mode for centralized log management and disable local authentication in favor of Entra ID for auditable identity management.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Application Insights",
      "nistControls": ["AU-6", "IA-2"],
      "frameworks": ["FedRAMP High", "DFARS/CUI", "CMMC 2.0 L2"]
    },
    "parameters": {
      "workspaceBasedEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Disabled"],
        "metadata": {
          "displayName": "Workspace-Based Mode Effect",
          "description": "Effect for the Application Insights workspace-based mode policy."
        }
      },
      "localAuthDisabledEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": ["Audit", "Disabled"],
        "metadata": {
          "displayName": "Local Auth Disabled Effect",
          "description": "Effect for the Application Insights local authentication disabled policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditAppInsightsWorkspaceBased",
        "policyDefinitionName": "audit-appinsights-workspace-based-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('workspaceBasedEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAppInsightsLocalAuthDisabled",
        "policyDefinitionName": "audit-appinsights-local-auth-disabled-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('localAuthDisabledEffect')]"
          }
        }
      }
    ]
  }
}
