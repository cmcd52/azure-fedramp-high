{
  "name": "fedramp-high-application-gateway-v1",
  "properties": {
    "displayName": "[FedRAMP High] Application Gateway Controls",
    "description": "Policy initiative for Application Gateway FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Application Gateway",
      "nistControls": [
        "AU-12",
        "AU-2",
        "IA-2",
        "AC-3"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditApplicationGatewayDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Application Gateway: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Application Gateway: Diagnostic Settings Enabled policy."
        }
      },
      "auditApplicationGatewayManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Application Gateway: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Application Gateway: Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditApplicationGatewayDiagnosticSettings",
        "policyDefinitionName": "audit-application-gateway-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditApplicationGatewayDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditApplicationGatewayManagedIdentity",
        "policyDefinitionName": "audit-application-gateway-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditApplicationGatewayManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
