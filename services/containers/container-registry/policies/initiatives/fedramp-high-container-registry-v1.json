{
  "name": "fedramp-high-container-registry-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Container Registry Controls",
    "description": "Policy initiative for Azure Container Registry FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Container Registry",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "IA-2",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditContainerRegistryDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Container Registry: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Container Registry: Diagnostic Settings Enabled policy."
        }
      },
      "denyContainerRegistryPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Container Registry: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Container Registry: Public Network Access Disabled policy."
        }
      },
      "auditContainerRegistryManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Container Registry: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Container Registry: Managed Identity Required policy."
        }
      },
      "auditContainerRegistryCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Container Registry: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure Container Registry: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditContainerRegistryDiagnosticSettings",
        "policyDefinitionName": "audit-container-registry-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditContainerRegistryDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyContainerRegistryPublicNetworkAccess",
        "policyDefinitionName": "deny-container-registry-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyContainerRegistryPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditContainerRegistryManagedIdentity",
        "policyDefinitionName": "audit-container-registry-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditContainerRegistryManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditContainerRegistryCmk",
        "policyDefinitionName": "audit-container-registry-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditContainerRegistryCmkEffect')]"
          }
        }
      }
    ]
  }
}
