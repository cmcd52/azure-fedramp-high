{
  "name": "fedramp-high-managed-grafana-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Managed Grafana Controls",
    "description": "Policy initiative for Azure Managed Grafana FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Managed Grafana",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "IA-2"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditManagedGrafanaDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Managed Grafana: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Managed Grafana: Diagnostic Settings Enabled policy."
        }
      },
      "denyManagedGrafanaPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Managed Grafana: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Managed Grafana: Public Network Access Disabled policy."
        }
      },
      "auditManagedGrafanaManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Managed Grafana: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Managed Grafana: Managed Identity Required policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditManagedGrafanaDiagnosticSettings",
        "policyDefinitionName": "audit-managed-grafana-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditManagedGrafanaDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyManagedGrafanaPublicNetworkAccess",
        "policyDefinitionName": "deny-managed-grafana-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyManagedGrafanaPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditManagedGrafanaManagedIdentity",
        "policyDefinitionName": "audit-managed-grafana-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditManagedGrafanaManagedIdentityEffect')]"
          }
        }
      }
    ]
  }
}
