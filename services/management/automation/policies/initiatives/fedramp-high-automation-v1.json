{
  "name": "fedramp-high-automation-v1",
  "properties": {
    "displayName": "[FedRAMP High] Azure Automation Controls",
    "description": "Policy initiative for Azure Automation FedRAMP High compliance. Bundles transmission confidentiality (SC-8/SC-13), boundary protection (SC-7), authentication (IA-2), encryption-at-rest (SC-28), and audit generation (AU-12) policies. Workloads hosting federal data MUST enforce all bundled controls.",
    "policyType": "Custom",
    "metadata": {
      "version": "1.0.0",
      "category": "FedRAMP High",
      "service": "Azure Automation",
      "nistControls": [
        "AU-12",
        "AU-2",
        "SC-7",
        "AC-3",
        "IA-2",
        "SC-12",
        "SC-13",
        "SC-28"
      ],
      "frameworks": [
        "FedRAMP High",
        "DFARS/CUI",
        "CMMC 2.0 L2"
      ]
    },
    "parameters": {
      "auditAutomationDiagnosticSettingsEffect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Automation: Diagnostic Settings Enabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Automation: Diagnostic Settings Enabled policy."
        }
      },
      "denyAutomationPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Automation: Public Network Access Disabled Effect",
          "description": "Effect for the [FedRAMP High] Azure Automation: Public Network Access Disabled policy."
        }
      },
      "auditAutomationManagedIdentityEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Automation: Managed Identity Required Effect",
          "description": "Effect for the [FedRAMP High] Azure Automation: Managed Identity Required policy."
        }
      },
      "auditAutomationCmkEffect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "[FedRAMP High] Azure Automation: Customer-Managed Key Encryption Effect",
          "description": "Effect for the [FedRAMP High] Azure Automation: Customer-Managed Key Encryption policy."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "auditAutomationDiagnosticSettings",
        "policyDefinitionName": "audit-automation-diagnostic-settings-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAutomationDiagnosticSettingsEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "denyAutomationPublicNetworkAccess",
        "policyDefinitionName": "deny-automation-public-network-access-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('denyAutomationPublicNetworkAccessEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAutomationManagedIdentity",
        "policyDefinitionName": "audit-automation-managed-identity-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAutomationManagedIdentityEffect')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "auditAutomationCmk",
        "policyDefinitionName": "audit-automation-cmk-v1",
        "parameters": {
          "effect": {
            "value": "[parameters('auditAutomationCmkEffect')]"
          }
        }
      }
    ]
  }
}
